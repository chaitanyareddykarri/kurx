# ============================================================
# Kurx environment — copy to .env and fill in.
# Dev defaults are zero-credential: console/mock/localdisk providers.
# ============================================================

# ---------- Core ----------
ASPNETCORE_ENVIRONMENT=Development
# Postgres connection (docker-compose and native fallback use the same values)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=kurx;Username=kurx;Password=kurx
# Used by docker-compose.yml for both the postgres container and the backend's
# ConnectionStrings__Default above — keep them in sync if you change this.
POSTGRES_PASSWORD=kurx

# ---------- Database connection pool (DB-2) ----------
# Explicit, because the Npgsql default of MaxPoolSize=100 PER PROCESS is wrong against this repo's own
# declared autoscaling: infra/terraform scales the API to 10 tasks against a db.t4g.medium offering
# ~439 connections, so the default ceiling demands ~1000. API traffic and Hangfire hold SEPARATE pools
# (distinguished by Application Name), so the per-task ceiling is MaxPoolSize + JobsMaxPoolSize.
# Full arithmetic: docs/deployment/CONNECTION_POOLING.md. Anything set directly in
# ConnectionStrings__Default wins over these — they are defaults, not a policy you cannot escape.
Database__MaxPoolSize=20
Database__JobsMaxPoolSize=8
Database__JobWorkerCount=5
Database__MinPoolSize=2
Database__CommandTimeoutSeconds=30
Database__ConnectionTimeoutSeconds=15
Database__ConnectionIdleLifetimeSeconds=300

# Redis (SignalR backplane + cache). Leave empty to run without a backplane in dev — it falls back to
# an in-memory cache. Production REFUSES TO BOOT without it (D-217 implements ADR-AM14): without Redis
# the SignalR backplane loses cross-instance fan-out, presence disables itself, and the chat rate
# limiter becomes per-instance, so N tasks serve N times the configured limit — all three look healthy.
REDIS_CONNECTION=localhost:6379
# Comma-separated CORS origins for admin + mobile dev. 3000 = web, 3001 = admin console
# (its SignalR live feed connects to the API straight from the browser), 8081 = Expo/mobile dev.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# ---------- Auth ----------
# HMAC-SHA256 signing key for JWTs.
# PRODUCTION REQUIREMENT: must be >=32 chars and NOT the placeholder below —
# Kurx.Api refuses to start with ASPNETCORE_ENVIRONMENT=Production otherwise
# (see backend/Kurx.Infrastructure/Configuration/SecretValidation.cs). Generate one with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=kurx
JWT_AUDIENCE=kurx-app
# HMAC key for ticket QR signatures — LIVE: read by TokenService.SignTicketCode and verified at the gate
# (GateEntryService), on ticket issuance, transfer, walk-in and seat-block. It is a SEPARATE key from
# JWT_SECRET on purpose; Production refuses to start if it is unset or still this placeholder, because
# reusing the session-signing key would make a leak of either compromise both.
# Generate one with: openssl rand -base64 48.  See docs/security/secret-management.md.
TICKET_HMAC_SECRET=dev-only-ticket-hmac-change-me

# ---------- First platform SuperAdmin (D-274) ----------
# There is no developer login, seeded identity, or OTP bypass in any build — the only way to get a
# session is the real authentication flow. That leaves one bootstrap problem: a brand-new database has
# no SuperAdmin, so nobody can reach the admin console to grant the first one.
#
# Set this to the phone number of a person who has ALREADY SIGNED IN at least once (the account must
# exist — this never creates a user). On the next API start, and only while zero SuperAdmins exist,
# they are granted SuperAdmin and the grant is written to the audit log. Unset it afterwards: it is a
# no-op once a SuperAdmin exists, and every further grant belongs in Staff & Roles.
#
# Locally, the OTP is delivered by the console provider — read it from the API log:
#   docker compose logs backend | grep 'sms→console'
SUPERADMIN_BOOTSTRAP_PHONE=

# ---------- Trusted Device Authentication (AM0-AM10) ----------
# Trusted-device authentication is ALWAYS ON — it is the authentication system, not a mode of it.
# The former AUTH_TRUSTED_DEVICE flag was removed in D-115: no code ever read it, so it described a
# kill switch that did not exist. Remove it from any .env you carry forward.
# Server-side pepper for OTP HMAC hashing (ADR-A4), read by OtpService via ISecretProvider.
# REQUIRED — Production refuses to start without it, and OTP issuance throws rather than falling back
# (D-115). The dev value below is deliberately explicit configuration, not a hidden code default:
# a fallback that "just works" is exactly how a production deploy ends up hashing every OTP under a
# pepper published in this repository. Generate a real one with: openssl rand -base64 32
OTP_PEPPER=dev-only-otp-pepper-change-me
# SMS delivery for OTP (AM1): sns | console. AWS SNS to India additionally needs DLT registration
# (SNS_ENTITY_ID + a per-template SNS_TEMPLATE_ID). Reuses AWS_REGION / AWS_ACCESS_KEY_ID below.
SMS_PROVIDER=console
# India DLT (TRAI) registration — required for SNS→India delivery. Registered principal entity id,
# per-template id, and the approved sender id. Empty in dev (console provider ignores them).
SNS_ENTITY_ID=
# India DLT registers a template id PER MESSAGE BODY. This global value is the fallback; when the bodies
# for different purposes diverge, set SNS_TEMPLATE_ID_<PURPOSE> (e.g. SNS_TEMPLATE_ID_PHONEVERIFICATION,
# SNS_TEMPLATE_ID_PASSWORDRESET, SNS_TEMPLATE_ID_ACCOUNTRECOVERY) — a mismatched id is rejected by the
# carrier, silently, at delivery time rather than at deploy time.
SNS_TEMPLATE_ID=
SNS_SENDER_ID=
# Challenge / step-up lifetimes (seconds).
AUTH_CHALLENGE_TTL_SECONDS=120
# Second-factor OTP challenges only (D-280). Longer than the challenge default on purpose: the user is
# waiting on a carrier or a mail provider, then reading and typing six digits, and the OTP itself lives
# 5 minutes — a 120s window expires while a valid code is still in flight. Does NOT affect device-approval
# or step-up windows, which stay short deliberately.
AUTH_SECOND_FACTOR_TTL_SECONDS=600
AUTH_STEPUP_TTL_SECONDS=300
# Trusted-browser lifetime (days). A trusted browser satisfies factor 2 only, never the password (D-127);
# defaults to 30 if unset.
AUTH_TRUSTED_BROWSER_TTL_DAYS=30
# WebAuthn / passkeys (AM3). RP_ID is the registrable domain the passkey is bound to and ORIGINS is the
# exact allow-list the browser must have been on — these are what make a passkey phishing-resistant, so
# they are explicit config and are never derived from the request Host header. ORIGINS falls back to
# ALLOWED_ORIGINS when unset. In production RP_ID is the bare domain (e.g. kurx.in) and origins are https.
# Region used to interpret PRE-EXISTING legacy phone rows during the staged E.164 backfill (D-089).
# Applies ONLY to the backfill job — new registrations never get a default region and must state one.
PHONE_BACKFILL_LEGACY_REGION=IN
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Kurx
WEBAUTHN_ORIGINS=http://localhost:3000

# ---------- Provider flags (dev defaults = no credentials needed) ----------
# email: ses | console — 'ses' is implemented (D-284) and needs SES_FROM_ADDRESS plus a verified identity.
EMAIL_PROVIDER=console
# whatsapp: cloudapi | console
WHATSAPP_PROVIDER=console
# payments: razorpay-sandbox | mock
PAYMENT_PROVIDER=mock
# storage: s3 | localdisk
STORAGE_PROVIDER=localdisk
# kyc: mock (only mock implemented; real provider slots in behind IKycProvider)
KYC_PROVIDER=mock
# D-323 — bypass the identity PROOFS in the trust matrix (govt ID, PAN, bank + penny-drop), so a plain
# account can publish a public event, organize a paid one and receive a payout without clearing them.
#   unset/false  Enforced. The default, and what CI and the test suite run with.
#   true         Bypassed. Development and test ONLY — startup THROWS if this is set in Production.
# It exists because every proof it relaxes is answered by MockKycProvider today (DigiLocker always
# approves; PAN and penny-drop pass for anything not ending "0000"), so enforcing them establishes
# nothing and costs four submissions per test account. Turn it OFF the moment a real DigiLocker /
# penny-drop adapter ships — that is the point at which the gate starts meaning something.
# Does NOT relax the blacklist or risk-score checks: those are real code and stay enforced either way.
IDENTITY_VERIFICATION_BYPASS=false
# Malware scanning for uploaded objects (D-110, real provider D-298).
#   none    NO-OP, NO protection. Development only. It exists so the upload pipeline always has a
#           scanner to call, which is what makes turning protection on a config change.
#   clamav  Real scanning against a ClamAV daemon over clamd's INSTREAM protocol.
# clamav FAILS CLOSED: if clamd is unreachable or slow, uploads are REJECTED rather than accepted
# unscanned. That is deliberate — plan for clamd's availability, do not work around it.
# The daemon starts with the default `docker compose up` — no profile needed.
# ---------- Fraud signals ----------
# Comma-separated disposable/throwaway email domains. ABSENT BY DEFAULT, which makes the check inert —
# the correct state for an install that has not decided its policy.
#
# This is DETECTION, not enforcement. A verified address on one of these domains records a
# `DisposableContact` fraud signal (score 10, well under the 100 that gates paid organising); it never
# refuses a registration or a verification, and existing verified accounts are never re-scored. Email is
# not an authentication factor here — phone OTP is — so a throwaway address costs little, while blocking
# one would hit students on temporary institutional addresses hardest.
#
# Subdomains of a listed domain match too (team.mailinator.com matches mailinator.com), anchored on a dot
# boundary so notmailinator.com does not. Kept in config rather than source because these lists change
# constantly and carry false positives: a wrong entry should be fixable without a deploy.
# Example: DISPOSABLE_EMAIL_DOMAINS=mailinator.com,guerrillamail.com,10minutemail.com,tempmail.com
DISPOSABLE_EMAIL_DOMAINS=

# Malware scanning for every upload path (D-298, coverage completed in D-338).
# Values: none | clamav
#   none   — NoOpFileScanner: reports every file Clean WITHOUT READING IT. No protection whatsoever.
#            Dev/test only; the API REFUSES TO START in Production with this (D-338).
#   clamav — real clamd over TCP, fails closed. The daemon starts with the default
#            `docker compose up`; allow ~2 min before its first scan (signature database load).
FILE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Includes the first-signature-load wait on a cold clamd, which can take a minute or two.
CLAMAV_TIMEOUT_SECONDS=30
# Rasterises a PDF page to PNG for certificate previews. 'stub' returns a blank 1x1 image.
# Values: stub
DOCUMENT_RASTERIZER=stub
# push: fcm | console
PUSH_PROVIDER=console

# ---------- Amazon SES v2 (EMAIL_PROVIDER=ses) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# REQUIRED when EMAIL_PROVIDER=ses. SES refuses to send from an unverified identity, so this cannot be
# defaulted — startup throws if it is missing rather than failing on the first send.
SES_FROM_ADDRESS=no-reply@kurx.in
SES_FROM_NAME=Kurx
# Optional. A configuration set is what routes bounce/complaint events somewhere. Leave empty until that
# pipeline exists; SES sends fine without it, you just learn nothing about delivery (D-284).
SES_CONFIGURATION_SET=

# ---------- S3 (STORAGE_PROVIDER=s3) ----------
S3_BUCKET=kurx-media
S3_REGION=ap-south-1
# Optional custom endpoint (e.g. MinIO)
S3_ENDPOINT=
# Presigned URL lifetimes (seconds)
PRESIGN_PUT_TTL=900
PRESIGN_GET_TTL=3600
# localdisk root (STORAGE_PROVIDER=localdisk)
LOCALDISK_ROOT=.localdata/storage

# ---------- Razorpay (PAYMENT_PROVIDER=razorpay-sandbox) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Route: platform account used for linked-account transfers
RAZORPAY_ROUTE_ENABLED=true

# ---------- WhatsApp Cloud API (WHATSAPP_PROVIDER=cloudapi) ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---------- Firebase Cloud Messaging (PUSH_PROVIDER=firebase) ----------
# Path to the Firebase service-account JSON file
FCM_SERVICE_ACCOUNT_JSON_PATH=

# ---------- Payout policy overrides (paise / percents; defaults per docs/DECISIONS.md D-007) ----------
PAYOUT_T1_ADVANCE_PCT=50
PAYOUT_T1_CAP_PAISE=5000000
PAYOUT_T1_FIRST_DELAY_DAYS=5
PAYOUT_T1_RESERVE_PCT=12
PAYOUT_T2_ADVANCE_PCT=75
PAYOUT_T2_RESERVE_PCT=8
PAYOUT_T3_ADVANCE_PCT=100
PAYOUT_T3_RESERVE_PCT=2
RESERVE_HOLD_DAYS=7

# ---------- Web (Next.js) ----------
# Must be NEXT_PUBLIC_API_BASE_URL — web/lib/site.ts reads this exact name.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
# The dedicated admin console's public URL — web's former /host/admin/* pages redirect here (D-195).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ---------- Admin (Next.js) ----------
# Must be NEXT_PUBLIC_API_URL — admin/lib/site.ts and admin/middleware.ts read this exact name
# (NOT NEXT_PUBLIC_API_BASE, which nothing reads). Server-side renders use API_URL instead.
NEXT_PUBLIC_API_URL=http://localhost:5080

# ---------- Mobile (Flutter, --dart-define or env.dart) ----------
# API base the app talks to; use your LAN IP for a real device
KURX_API_BASE=http://localhost:5080
# razorpay_flutter sandbox key (public key id only; never the secret)
KURX_RAZORPAY_KEY_ID=

# ── JWT signing keys (AM10, D-099) ────────────────────────────────────────────
# How long a rotated ES256 key keeps VALIDATING after it stops signing. Must exceed the access-token
# lifetime (1h) or a rotation would invalidate tokens that have not expired yet — the service refuses
# to rotate if this is set too low. Retirement then destroys the private half.
JWT_KEY_GRACE_HOURS=24
# JWT_SECRET below remains required: it still validates legacy HS256 tokens minted before the ES256
# cut-over. It can only be removed once no HS256 token can still be within its lifetime.

# ── Secrets provider (AM10, D-101a) ───────────────────────────────────────────
# configuration | aws
#   configuration — reads IConfiguration, which already layers appsettings, user-secrets AND
#                   environment variables. This is the right choice for local dev and for any
#                   deployment that injects secrets as env vars (ECS task secrets, K8s secrets).
#   aws          — AWS Secrets Manager, with a short TTL cache (billed per call, rate-limited).
# An unrecognised value fails startup rather than falling back to an unintended source.
SECRETS_PROVIDER=configuration
# Optional prefix so one AWS account can host several environments: kurx/production/JWT_SECRET
AWS_SECRETS_PREFIX=
AWS_SECRETS_CACHE_MINUTES=5

# ── Signing-key protection at rest (AM10, D-102a) ─────────────────────────────
# kms | none.  Defaults to 'kms' in Production and 'none' elsewhere.
# 'none' stores the private signing key unwrapped and is REFUSED in Production — an unprotected
# signing key means a database dump is a complete authentication bypass.
SIGNING_KEY_PROTECTION=none
# Required when SIGNING_KEY_PROTECTION=kms. The CMK used for envelope encryption of signing keys.
# IAM needs only kms:GenerateDataKey, kms:Decrypt and kms:DescribeKey on this key — nothing more.
AWS_KMS_SIGNING_KEY_ID=

# ── OpenTelemetry (AM10, D-100) ───────────────────────────────────────────────
# OTLP collector endpoint. Leave EMPTY to export nothing — there is deliberately no default
# endpoint, because a silently mis-targeted exporter looks identical to a working one until an
# incident, when the data isn't there. In production this is the ADOT sidecar on localhost.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name on every span and metric. Defaults to 'kurx-api' when unset.
OTEL_SERVICE_NAME=kurx-api
