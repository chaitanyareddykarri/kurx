.localdata/
.localtools/
/storage/
*.log

# Local dev tooling & test artifacts (never commit)
.serena/
backend/Kurx.Tests/TestResults/
# Scratch access token written by hand during local API poking. Untracked but NOT ignored meant it sat
# one `git add .` away from being committed — the one class of mistake that cannot be undone by a revert,
# because anything pushed must be treated as disclosed.
.tok
# Intermediate written by scripts/generate-openapi.sh's predecessor and by manual spec pulls. The real
# contract is docs/api/openapi.json; a 500KB scratch copy at the repo root is noise that invites someone
# to diff or commit the wrong one.
spec_tmp.json

# Compose override — read automatically by `docker compose` on top of docker-compose.yml, and by
# convention machine-local: it carries one developer's volume names, ports and image pins. Committing
# one silently changes the stack for everyone else, and the symptom (a container bound to a volume or
# port that only makes sense on another machine) never points back at this file.
docker-compose.override.yml
docker-compose.override.yaml

# Personal Obsidian vault (duplicates docs/; workspace state is machine-local)
Kurx-Obsidian-Vault/

# OS
.DS_Store
node_modules

# Personal Claude Code permissions (never commit: grants unattended terraform apply)
.claude/settings.local.json

# Claude Code runtime state — machine-local, regenerated, and meaningless to anyone else.
# These were previously ignored only via .git/info/exclude, which is NOT shared on clone: a fresh
# clone saw them as untracked and one `git add .` away from being committed. Kept here so the rule
# travels with the repository.
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/routines/.state/
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.claude/agent-registry.json
.claude/agent-memory-local/
.claude/first-run
.claude/assistant-daemon-state.json
