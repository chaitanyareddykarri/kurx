# Build context is ./backend (see docker-compose.yml).
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
# Project manifests before sources so the restore layer is keyed on dependency changes alone. The
# previous `COPY . .` ahead of publish invalidated restore on every source edit, so each build
# re-downloaded the entire package graph. Only Kurx.Api's transitive closure is needed — Kurx.Tests
# is not published.
COPY Kurx.Api/Kurx.Api.csproj ./Kurx.Api/
COPY Kurx.Application/Kurx.Application.csproj ./Kurx.Application/
COPY Kurx.Domain/Kurx.Domain.csproj ./Kurx.Domain/
COPY Kurx.Infrastructure/Kurx.Infrastructure.csproj ./Kurx.Infrastructure/
# Directory.Build.props travels WITH the manifests, not with the sources below. D-345 set
# `ArtifactsPath=/tmp/kurx-artifacts` for non-Windows builds; without this line `restore` ran before the
# file arrived and wrote assets to the default `obj/`, then `publish --no-restore` — which now saw the
# property — looked in /tmp and failed with NETSDK1004. The two halves have to agree on where assets live,
# so the file that decides it must be present for both.
#
# This is not a CI-only concern: `docker build` does not inherit the daemon host's environment, so D-345's
# `'$(GITHUB_ACTIONS)' != 'true'` guard is false inside the image and the redirect applies in CD too.
COPY Directory.Build.props ./
RUN dotnet restore Kurx.Api/Kurx.Api.csproj
COPY . .
RUN dotnet publish Kurx.Api/Kurx.Api.csproj -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
# `tesseract-ocr` backs ITextDetector (D-355). Deliberately the CLI rather than a managed wrapper: a
# wrapper pins a native libtesseract ABI and the two drift, which on arm64 shows up as a load failure at
# runtime rather than a build error. The binary's TSV output already carries per-word boxes and
# confidence, which is exactly the boundary's shape, so the wrapper would add a dependency and no
# capability. `eng` is the only language pack installed — certificates in other scripts fall back to the
# unavailable answer rather than to a bad transcription.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app .
# Run unprivileged (D-256). APP_UID is the non-root user the aspnet base image already provides, so
# there is no useradd here. The published output stays root-owned and read-only to the app — the
# process has no reason to rewrite its own binaries — but LOCALDISK_ROOT does need to be writable:
# LocalDiskStorage calls Directory.CreateDirectory on it in its constructor, so the container would
# fail to start without this. Path mirrors the provider's default of ".localdata/storage" under the
# working directory.
RUN mkdir -p /app/.localdata/storage && chown -R $APP_UID:$APP_UID /app/.localdata
USER $APP_UID
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Kurx.Api.dll"]
