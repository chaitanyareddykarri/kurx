<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- targetSdk 36 blocks cleartext HTTP, so a debug build cannot reach the local
         dev API over http:// (10.0.2.2 is the host's loopback from the emulator).
         Debug-only — this manifest never merges into a release build, so production
         stays HTTPS-only. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
